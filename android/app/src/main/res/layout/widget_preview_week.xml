                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="RDV"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
