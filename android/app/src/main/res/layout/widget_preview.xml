<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu widget Jour (grille horaire) -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:id="@+id/tv_label"
                android:text="JOUR"
                android:textColor="#3B5F51"
                android:textSize="9sp"
                android:fontFamily="monospace" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tv_title"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Aujourd’hui"
                android:textColor="#1C1D21"
                android:textSize="24sp"
                android:fontFamily="serif"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:id="@+id/btn_prev"
            android:layout_marginStart="0dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:text="‹"
            android:textColor="#1C1D21"
            android:textSize="16sp" />
        <TextView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:id="@+id/btn_next"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:text="›"
            android:textColor="#1C1D21"
            android:textSize="16sp" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E3DFD4"
                    android:layout_marginStart="32dp" />
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="2dp"
                    android:text="8h"
                    android:textColor="#9B9C96"
                    android:textSize="8.5sp" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E3DFD4"
                    android:layout_marginStart="32dp" />
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="2dp"
                    android:text="9h"
                    android:textColor="#9B9C96"
                    android:textSize="8.5sp" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E3DFD4"
                    android:layout_marginStart="32dp" />
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="2dp"
                    android:text="10h"
                    android:textColor="#9B9C96"
                    android:textSize="8.5sp" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E3DFD4"
                    android:layout_marginStart="32dp" />
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="2dp"
                    android:text="11h"
                    android:textColor="#9B9C96"
                    android:textSize="8.5sp" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E3DFD4"
                    android:layout_marginStart="32dp" />
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="2dp"
                    android:text="12h"
                    android:textColor="#9B9C96"
                    android:textSize="8.5sp" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E3DFD4"
                    android:layout_marginStart="32dp" />
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="2dp"
                    android:text="13h"
                    android:textColor="#9B9C96"
                    android:textSize="8.5sp" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E3DFD4"
                    android:layout_marginStart="32dp" />
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="2dp"
                    android:text="14h"
                    android:textColor="#9B9C96"
                    android:textSize="8.5sp" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginStart="32dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:layout_weight="1.5"
                android:background="@drawable/widget_block_green_soft"
                android:layout_marginEnd="2dp"
                android:layout_marginStart="1dp">
                <FrameLayout
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_bar_green" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingStart="6dp"
                    android:paddingTop="3dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Cours de maths"
                        android:textColor="#1C1D21"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="09:00"
                        android:textColor="#5B5F66"
                        android:textSize="8.5sp" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2.5" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:background="@drawable/widget_block_terracotta_soft"
                android:layout_marginEnd="2dp"
                android:layout_marginStart="1dp">
                <FrameLayout
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_bar_terracotta" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingStart="6dp"
                    android:paddingTop="3dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Réviser le chapitre 3"
                        android:textColor="#1C1D21"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3.5" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="28dp">
                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/widget_now_dot" />
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="@drawable/widget_now_line"
                    android:layout_weight="1" />
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3.5" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
